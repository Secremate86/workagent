{
  "name": "@workagent/workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "Local office workbench built on Pi and Pi Web",
  "homepage": "https://github.com/Secremate86/workagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Secremate86/workagent.git"
  },
  "bugs": {
    "url": "https://github.com/Secremate86/workagent/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "workagent": "node scripts/workagent-dev.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "node --import ./scripts/workagent-sdk-hooks.mjs ./node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "node --import ./scripts/workagent-sdk-hooks.mjs ./node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "node --import ./scripts/workagent-sdk-hooks.mjs ./node_modules/next/dist/bin/next start -H 127.0.0.1 -p 30141",
    "start:lan": "node --import ./scripts/workagent-sdk-hooks.mjs ./node_modules/next/dist/bin/next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --import ./scripts/workagent-sdk-hooks.mjs --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\" \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.2.3",
    "next": "16.3.8",
    "node-pty": "1.2.0-beta.15",
    "pi-memory": "0.4.2",
    "pi-routines": "0.1.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "micromark-util-types": "^2.0.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "refractor": "^5.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "unified": "^11.0.5"
  }
}
